# prediction-arb configuration
#
# Copy to `.env` (which is git-ignored) and fill in only what you need:
#   cp .env.example .env
#
# Scanning needs NO credentials: Kalshi and Polymarket market data are public.
# Credentials are only used for live order placement (DRY_RUN=false + --live).
# Full reference: docs/configuration.md

# ─── Mode ────────────────────────────────────────────────────────────────────
DRY_RUN=true                     # true = log what would be traded, place no orders

# ─── Strategy & risk ─────────────────────────────────────────────────────────
MIN_PROFIT_PCT=0.02              # minimum net return on capital after fees (0.02 = 2%)
MAX_POSITION_USD=50              # all-in budget per arbitrage (both legs + fees)
MAX_OPEN_POSITIONS=5             # stop opening new positions beyond this many
MAX_DAYS_TO_RESOLUTION=14        # only trade markets resolving within N days (0 = no limit)
EXECUTION_MIN_MATCH_SCORE=85     # minimum title-match score (0-100) required to trade
MIN_VOLUME=100                   # minimum traded volume on each market
POLL_INTERVAL_SEC=30             # seconds between scans (minimum 5)

# ─── Kalshi (live trading only) ──────────────────────────────────────────────
# Create an API key at https://kalshi.com/account/profile (API Keys section).
# Prefer KALSHI_PRIVATE_KEY_PATH: keep the .pem outside this repository, chmod 600.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=         # e.g. ~/.config/prediction-arb/kalshi.pem
# KALSHI_PRIVATE_KEY=            # alternative for CI: PEM on one line with literal \n
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
# KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2   # Kalshi demo environment

# ─── Polymarket (live trading only) ──────────────────────────────────────────
# Requires: pip install "prediction-arb[trading]"
# Use a dedicated wallet holding only what you are prepared to lose.
POLY_PRIVATE_KEY=                # private key of the signing wallet (0x...)
POLY_SIGNATURE_TYPE=0            # 0 = EOA wallet, 1 = email/Magic login, 2 = browser-wallet proxy
POLY_FUNDER_ADDRESS=             # proxy wallet address holding funds (required for types 1 and 2)
# API credentials are derived from POLY_PRIVATE_KEY automatically; set these to reuse existing ones.
# POLY_API_KEY=
# POLY_API_SECRET=
# POLY_PASSPHRASE=

# ─── Runtime ─────────────────────────────────────────────────────────────────
# DB_PATH=data/positions.db
# LOG_FILE=logs/bot.log          # empty to disable file logging
# LOG_LEVEL=INFO
