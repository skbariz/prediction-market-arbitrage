# ─── Kalshi Credentials ──────────────────────────────────────────────────────
# Get these from: https://kalshi.com/profile/api (API Access section)
#
# IMPORTANT: The private key must be formatted as a single line with literal \n
# between each line of the PEM block. Run `python scripts/format_kalshi_key.py`
# to auto-convert a multi-line PEM file.
KALSHI_API_KEY_ID=your-key-id-uuid-here
KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# ─── Polymarket Credentials ───────────────────────────────────────────────────
# NOTE: Read-only market scanning requires NO credentials.
# These are only needed when DRY_RUN=false for live order placement.
# Get these from: https://docs.polymarket.com/#authentication
POLY_PRIVATE_KEY=your_polygon_wallet_private_key_here
POLY_API_KEY=your_polymarket_api_key_here
POLY_API_SECRET=your_polymarket_api_secret_here
POLY_PASSPHRASE=your_polymarket_passphrase_here
POLY_CLOB_URL=https://clob.polymarket.com

# ─── Bot Settings ─────────────────────────────────────────────────────────────
MIN_PROFIT_PCT=0.02        # Minimum net profit % after fees to place a trade (default: 2%)
MAX_POSITION_USD=50.00     # Max USD to deploy per arb pair
POLL_INTERVAL_SEC=30       # Seconds between market scans
DRY_RUN=true               # Set false to enable live trading (start here!)
MAX_DAYS_TO_RESOLUTION=7   # Only trade markets resolving within N days (hard max: 14)
